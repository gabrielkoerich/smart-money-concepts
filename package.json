    "reporter": "spec"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test bun --bun mocha -t 5000 'tests/**/*.test.ts' --exit"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
