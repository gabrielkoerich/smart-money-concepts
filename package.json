{
  "name": "smart-money-concepts",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.15.29",
    "chai": "^6.2.1",
    "mocha": "^11.7.5",
    "typescript": "^5.9.3"
  },
  "exports": {
